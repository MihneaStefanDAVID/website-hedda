---
layout: base.njk
mainClass: project-main
includeScript: true
---
<!--
  Two columns: text on the left (40%, fixed in place), photos/GIFs/
  videos on the right (60%) in rows of 1–4 shown side by side at equal
  height (see script.js). Each row has an optional size and alignment.
  Clicking an item opens it enlarged in the lightbox.

  Page type "Images only" (page_type: images, chosen in the CMS) drops the
  text column: a bar with "go back", the title and EN/DE (for the
  captions), then the photos across
  the whole width.
-->
{% set imagesOnly = page_type == "images" %}
<div class="project-layout{% if imagesOnly %} project-layout--images{% endif %}">
  {% if imagesOnly %}
  <div class="project-topbar">
    <a href="/" class="project-header__back"><span class="lang-en">go back</span><span class="lang-de">zurück</span></a>
    <h1 class="project-topbar__title">{{ title }}</h1>
    <div class="lang-switch" role="group" aria-label="Language">
      <button type="button" data-set-lang="en" lang="en">EN</button>
      <span aria-hidden="true">/</span>
      <button type="button" data-set-lang="de" lang="de">DE</button>
    </div>
  </div>
  {% else %}
  <div class="project-text">
    <!--
      English / German: both versions are in the page and CSS shows one,
      based on html[data-lang] (set before first paint in base.njk, and
      by the EN/DE switch in script.js). Without German text, the English
      text shows in both languages.
    -->
    <div class="project-topbar">
      <a href="/" class="project-header__back"><span class="lang-en">go back</span><span class="lang-de">zurück</span></a>
      <div class="lang-switch" role="group" aria-label="Language">
        <button type="button" data-set-lang="en" lang="en">EN</button>
        <span aria-hidden="true">/</span>
        <button type="button" data-set-lang="de" lang="de">DE</button>
      </div>
    </div>

    <table class="project-facts">
      <thead>
        <tr>
          <th><span class="lang-en">Project</span><span class="lang-de">Projekt</span></th>
          {% if supervision %}<th><span class="lang-en">Supervision</span><span class="lang-de">Betreuung</span></th>{% endif %}
          {% if semester %}<th>Semester</th>{% endif %}
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><h1 class="project-facts__title">{{ title }}</h1></td>
          {% if supervision %}<td>{{ supervision }}</td>{% endif %}
          {% if semester %}<td>{{ semester }}</td>{% endif %}
        </tr>
      </tbody>
    </table>

    {% if body_de %}
    <div class="project-content lang-en" lang="en">{{ content | safe }}</div>
    <div class="project-content lang-de" lang="de">{{ body_de | safe }}</div>
    {% else %}
    <div class="project-content">{{ content | safe }}</div>
    {% endif %}
  </div>
  {% endif %}

  <div class="project-gallery">
    {% if gallery and gallery.length %}
    <!-- Visitors rarely expect photos to open; a quiet line says so. -->
    <p class="project-gallery__hint">
      <span class="lang-en"><span class="hint-click">click</span><span class="hint-tap">tap</span> the content to see details</span>
      <span class="lang-de">für Details auf den Inhalt <span class="hint-click">klicken</span><span class="hint-tap">tippen</span></span>
    </p>
    {% endif %}
    {% for row in gallery %}
    <div class="project-gallery__row project-gallery__row--{{ row.size or 'full' }} project-gallery__row--align-{{ row.align or 'center' }}">
      {#
        Each entry is { image, caption, caption_de }; older projects saved
        just the file path. A PDF's caption goes under its last page.
      #}
      {% for entry in row.photos %}{% set file = entry.image if entry.image else entry %}{% if file and file.length %}{% for item in file | galleryFiles(pdf) %}
      <figure class="project-gallery__cell">
        <button class="project-gallery__item" type="button" aria-label="Enlarge">
          {% if item | isVideo %}
          <video src="{{ item | imagePath }}" autoplay muted loop playsinline preload="metadata"></video>
          {% else %}
          <img src="{{ item | webPath(media) }}" data-zoom="{{ item | zoomPath(media) }}" alt="{{ entry.caption or title }}" loading="lazy" />
          {% endif %}
        </button>
        {% if loop.last and entry.caption %}
        <figcaption class="project-gallery__caption">
          {%- if entry.caption_de -%}
          <span class="lang-en" lang="en">{{ entry.caption }}</span><span class="lang-de" lang="de">{{ entry.caption_de }}</span>
          {%- else -%}
          {{ entry.caption }}
          {%- endif -%}
        </figcaption>
        {% endif %}
      </figure>
      {% endfor %}{% endif %}{% endfor %}
    </div>
    {% endfor %}
  </div>
</div>
