---
layout: base.njk
mainClass: project-main
includeScript: true
---
<!--
  Two columns: text on the left (40%, fixed in place), photos on the
  right (60%) in rows of 1–4 shown side by side at equal height (see
  script.js). Clicking a photo opens it enlarged in the lightbox.
-->
<div class="project-layout">
  <div class="project-text">
    <a href="/" class="project-header__back">go back</a>

    <table class="project-facts">
      <thead>
        <tr>
          <th>Project</th>
          {% if supervision %}<th>Supervision</th>{% endif %}
          {% if semester %}<th>Semester</th>{% endif %}
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><h1 class="project-facts__title">{{ title }}</h1></td>
          {% if supervision %}<td>{{ supervision }}</td>{% endif %}
          {% if semester %}<td>{{ semester }}</td>{% endif %}
        </tr>
      </tbody>
    </table>

    <div class="project-content">{{ content | safe }}</div>
  </div>

  <div class="project-gallery">
    {% for row in gallery %}
    <div class="project-gallery__row">
      {% for image in row.photos %}{% if image %}
      <button class="project-gallery__item" type="button" aria-label="Enlarge photo">
        <img src="{{ image | imagePath }}" alt="{{ title }}" loading="lazy" />
      </button>
      {% endif %}{% endfor %}
    </div>
    {% endfor %}
  </div>
</div>
